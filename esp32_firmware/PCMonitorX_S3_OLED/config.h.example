#pragma once
// Copy to config.h (same folder). config.h is git-ignored; never share it.
#define PCMONITORX_WIFI_SSID "your-wifi-name"
#define PCMONITORX_WIFI_PASSWORD "your-wifi-password"
#define PCMONITORX_SERVER_HOST "192.168.1.100"  // Windows PC LAN IPv4
#define PCMONITORX_SERVER_PORT 8765
#define PCMONITORX_API_TOKEN ""

// OLED (use the pins/address found by diagnostics/ESP32S3_I2C_Pin_Scan)
#define PCMONITORX_OLED_SDA 8
#define PCMONITORX_OLED_SCL 9
#define PCMONITORX_OLED_ADDRESS 0x3C
#define PCMONITORX_OLED_SH1106 1  // 1 = SH1106 (typical 1.3"), 0 = SSD1306

#define PCMONITORX_BUTTON_PIN 0   // BOOT button: short = next page, long = settings
