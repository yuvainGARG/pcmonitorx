#pragma once
// Copy this file to config.h (same folder) and fill in your values.
// config.h is git-ignored; never commit or share it.

// ---- Network ----
#define PCMONITORX_WIFI_SSID "your-wifi-name"
#define PCMONITORX_WIFI_PASSWORD "your-wifi-password"
#define PCMONITORX_SERVER_HOST "192.168.1.100"  // Windows PC LAN IPv4 address
#define PCMONITORX_SERVER_PORT 8765
#define PCMONITORX_API_TOKEN ""  // Optional; must match PCMONITORX_API_TOKEN on the PC

// ---- Display (set from ESP32_035_Probe results) ----
// One of: PCMX_PANEL_ST7796, PCMX_PANEL_ILI9488, PCMX_PANEL_ILI9341
// ST7796 is the leading hypothesis for 3.5" 320x480 "cheap yellow display" boards,
// but it is NOT verified for your board. Change after running the probe.
#define PCMONITORX_PANEL PCMX_PANEL_ST7796
#define PCMONITORX_PANEL_INVERT 0  // 1 if the probe shows inverted colours (white looks black)
#define PCMONITORX_PANEL_BGR 0     // 1 if the probe's RED bar appears blue

// ---- Input ----
// Touch stays off until the probe shows sensible XPT2046 readings on CS33/IRQ36.
#define PCMONITORX_TOUCH_ENABLED 0
// BOOT button (GPIO0): short press = next page, long press = settings action.
#define PCMONITORX_BOOT_BUTTON_ENABLED 1
