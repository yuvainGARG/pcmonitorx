#pragma once
// Copy this file to config.h and fill in values for your LAN.
#define PCMONITORX_WIFI_SSID "your-wifi-name"
#define PCMONITORX_WIFI_PASSWORD "your-wifi-password"
#define PCMONITORX_SERVER_HOST "192.168.1.100" // Windows PC LAN IPv4 address
#define PCMONITORX_SERVER_PORT 8765
#define PCMONITORX_API_TOKEN "" // Optional; must match PCMONITORX_API_TOKEN on the PC
#define PCMONITORX_OLED_ADDRESS 0x3C // Set to 0x3D if scanner reports that address
// After running the I2C/display diagnostic, uncomment the matching selection:
// #define PCMONITORX_OLED_SH1106 1 // SH1106
// #define PCMONITORX_OLED_SH1106 0 // SSD1306
#define PCMONITORX_BUTTONS_ENABLED 1 // Buttons: GPIO32=mode, GPIO33=adjust, each to GND
