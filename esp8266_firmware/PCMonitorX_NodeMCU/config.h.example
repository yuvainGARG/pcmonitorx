#pragma once

// Copy this file to config.h, then enter the Windows PC's LAN address.
#define PCMONITORX_WIFI_SSID "your-wifi-name"
#define PCMONITORX_WIFI_PASSWORD "your-wifi-password"
#define PCMONITORX_SERVER_HOST "192.168.1.100"
#define PCMONITORX_SERVER_PORT 8765
#define PCMONITORX_API_TOKEN ""

// Scanner result is usually 0x3C. Change only if the scanner reports 0x3D.
#define PCMONITORX_OLED_ADDRESS 0x3C

// Set 1 for SH1106, or 0 for SSD1306 after a successful display test.
#define PCMONITORX_OLED_SH1106 1

// Optional buttons: D5/GPIO14 mode and D6/GPIO12 adjust, each connected to GND.
#define PCMONITORX_BUTTONS_ENABLED 0
